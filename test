# new edit 
name: Terraform Deployment to Azure

on:
  push:
    branches:
      - server  # Change this to your desired branch

jobs:
  terraform:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v2

      - name: Set up Terraform
        uses: hashicorp/setup-terraform@v2
        with:
          terraform_version: 1.4.5  # Update to your preferred version

      - name: Azure Login
        uses: azure/login@v1
        with:
            creds: ${{ secrets.AZURE_CREDENTIALS }}
  
      - name: Terraform Init
        run: terraform init

      - name: Terraform Plan
        run: terraform plan -var="ssh_public_key=$(cat ~/.ssh/id_rsa.pub)" -out=tfplan

      - name: Terraform Apply
        if: github.ref == 'refs/heads/main'  # Only applies on the main branch
        run: terraform apply -auto-approve tfplan
